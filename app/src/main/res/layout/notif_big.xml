<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layoutDirection="ltr" android:background="@drawable/banner_bg" android:paddingLeft="14dp" android:paddingRight="14dp"
    android:paddingTop="8dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/b_left" android:fontFamily="@font/thmanyah" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:gravity="left" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold" android:maxLines="1"/>
            <Chronometer android:id="@+id/b_timer" android:fontFamily="@font/thmanyah" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F5C84C" android:textSize="22sp" android:textStyle="bold" android:layout_marginLeft="8dp" android:layout_marginRight="8dp"/>
            <TextView android:id="@+id/b_right" android:fontFamily="@font/thmanyah" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:gravity="right" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold" android:maxLines="1"/>
        </LinearLayout>
        <TextView android:id="@+id/b_sub" android:fontFamily="@font/thmanyah" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1" android:layout_marginTop="2dp"/>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:src="@drawable/gold_line" android:scaleType="fitXY" android:layout_marginTop="8dp" android:layout_marginBottom="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:id="@+id/c0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginLeft="2dp" android:layout_marginRight="2dp">
                <TextView android:id="@+id/cn0" android:fontFamily="@font/thmanyah" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#D9FFFFFF" android:textSize="11sp" android:maxLines="1"/>
                <TextView android:id="@+id/ct0" android:fontFamily="@font/thmanyah" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/c1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginLeft="2dp" android:layout_marginRight="2dp">
                <TextView android:id="@+id/cn1" android:fontFamily="@font/thmanyah" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#D9FFFFFF" android:textSize="11sp" android:maxLines="1"/>
                <TextView android:id="@+id/ct1" android:fontFamily="@font/thmanyah" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/c2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginLeft="2dp" android:layout_marginRight="2dp">
                <TextView android:id="@+id/cn2" android:fontFamily="@font/thmanyah" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#D9FFFFFF" android:textSize="11sp" android:maxLines="1"/>
                <TextView android:id="@+id/ct2" android:fontFamily="@font/thmanyah" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/c3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginLeft="2dp" android:layout_marginRight="2dp">
                <TextView android:id="@+id/cn3" android:fontFamily="@font/thmanyah" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#D9FFFFFF" android:textSize="11sp" android:maxLines="1"/>
                <TextView android:id="@+id/ct3" android:fontFamily="@font/thmanyah" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/c4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginLeft="2dp" android:layout_marginRight="2dp">
                <TextView android:id="@+id/cn4" android:fontFamily="@font/thmanyah" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#D9FFFFFF" android:textSize="11sp" android:maxLines="1"/>
                <TextView android:id="@+id/ct4" android:fontFamily="@font/thmanyah" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/c5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginLeft="2dp" android:layout_marginRight="2dp">
                <TextView android:id="@+id/cn5" android:fontFamily="@font/thmanyah" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#D9FFFFFF" android:textSize="11sp" android:maxLines="1"/>
                <TextView android:id="@+id/ct5" android:fontFamily="@font/thmanyah" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
</LinearLayout>
